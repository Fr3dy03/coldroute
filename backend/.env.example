# ColdRoute Backend Environment
# Copy to .env and fill in values before running

PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coldroute?schema=public"
JWT_SECRET="change-me-in-production"

# BOT Chain configuration
BOT_TESTNET_RPC="https://rpc.bohr.life"
BOT_TESTNET_CHAIN_ID=968
BOT_TESTNET_EXPLORER="https://scan.bohr.life/"
BOT_MAINNET_RPC="https://rpc.botchain.ai"
BOT_MAINNET_CHAIN_ID=677
BOT_MAINNET_EXPLORER="https://scan.botchain.ai/"
BOT_CHAIN_ID=968
BOT_RPC_URL="https://rpc.bohr.life"

# Object storage (S3-compatible) for evidence documents
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="coldroute-evidence"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Redis / BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# Sensor adapter credentials (encrypted at rest in production)
DEMO_ADAPTER_ENABLED=true

# Deployment
DEPLOYER_PRIVATE_KEY="0x..."
