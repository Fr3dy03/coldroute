# Vercel Environment Variables for ColdRoute
# Copy these to your Vercel Project Settings > Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=https://your-backend-url.vercel.app/api

# BOT Chain Testnet (for development/demo)
NEXT_PUBLIC_BOT_TESTNET_RPC=https://rpc.bohr.life
NEXT_PUBLIC_BOT_TESTNET_CHAIN_ID=968
NEXT_PUBLIC_BOT_TESTNET_EXPLORER=https://scan.bohr.life/

# BOT Chain Mainnet
NEXT_PUBLIC_BOT_MAINNET_RPC=https://rpc.botchain.ai
NEXT_PUBLIC_BOT_MAINNET_CHAIN_ID=677
NEXT_PUBLIC_BOT_MAINNET_EXPLORER=https://scan.botchain.ai/

# Optional: Custom domain
# NEXT_PUBLIC_APP_URL=https://coldroute.vercel.app